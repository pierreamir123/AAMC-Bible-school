		{"id":"fn2","type":"file","x":1100,"y":6690,"width":500,"height":300,"file":"wiki/concepts/Servant Program - Stage 1b Theme.md","color":"4"},
		{"id":"fn3","type":"file","x":1650,"y":6690,"width":500,"height":300,"file":"wiki/concepts/Servant Program - Stage 2 Trident.md","color":"4"},
		{"id":"fn4","type":"file","x":0,"y":7020,"width":500,"height":300,"file":"wiki/concepts/Servant Program - Stage 3 Assessment.md","color":"4"},
		{"id":"fn5","type":"file","x":550,"y":7020,"width":500,"height":300,"file":"wiki/concepts/Servant Program - Stage 4 Rollout.md","color":"4"},
		{"id":"fn6","type":"file","x":1100,"y":7020,"width":500,"height":300,"file":"wiki/concepts/Servant Program - Stage 5 Product Catalog.md","color":"4"},
		{"id":"fn7","type":"file","x":1650,"y":7020,"width":500,"height":300,"file":"wiki/concepts/Servant Program - Stage 6 First 90 Days.md","color":"4"},
		{"id":"st6","type":"text","x":1650,"y":7020,"width":500,"height":300,"text":"## Stage 6 · أول ٩٠ يوماً\n🟡 لم يُكتب بعد","color":"3"},
		{"id":"dec","type":"text","x":0,"y":7370,"width":2200,"height":380,"text":"## 🔴 قرارات مفتوحة\n- اختيار الثيم (A/B/C) وتغيير اسم «Pillars» أو «الأعمدة»\n- أمين الخدمة · المراجع الكنسي · من يدرّس الفصول · موعد الاجتماع\n- سياسة حماية الأطفال في الكنيسة (يتأكد من الكنيسة)\n- حجم دفعة الـPilot · الميزانية · أعمار الخدام (تأكيد: جامعة ← ٤٠)\n- موعد التقييم · أداة السمات (استبيان بسيط أم مقنّن؟) · مكان تخزين الدرجات\n- اختيار المحاور وترتيبها في المراحل · سرعة فتح المراحل (+٢/+٢/+١)","color":"1"}
	],
